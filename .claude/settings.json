{
  "extraKnownMarketplaces": {
    "starlightpdf": {
      "source": {
        "source": "github",
        "repo": "Martin-Carlsson/StarlightPDF"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "build-voyage@starlightpdf": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt --check *)",
      "Bash(rustfmt --check *)",
      "Bash(shellcheck *)",
      "Bash(shasum *)",
      "Bash(cargo metadata *)",
      "Bash(cargo tree *)"
    ]
  }
}
